generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SALES
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(SALES)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enquiries   Enquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
}

model Customer {
  id            Int      @id @default(autoincrement())
  companyName   String
  contactPerson String
  mobile        String
  email         String?
  city          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enquiries   Enquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
}

model Product {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  category  String
  unit      String
  basePrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory       Inventory?
  enquiryItems    EnquiryItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  dispatchItems   DispatchItem[]
}

model Inventory {
  id               Int @id @default(autoincrement())
  productId        Int @unique
  physicalQuantity Int @default(0)
  reservedQuantity Int @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id            Int           @id @default(autoincrement())
  enquiryNumber String        @unique
  customerId    Int
  enquiryDate   DateTime
  requiredDate  DateTime
  notes         String?
  status        EnquiryStatus @default(NEW)
  createdById   Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer  Customer     @relation(fields: [customerId], references: [id])
  createdBy User         @relation(fields: [createdById], references: [id])
  items     EnquiryItem[]
  quotation Quotation?
}

model EnquiryItem {
  id        Int @id @default(autoincrement())
  enquiryId Int
  productId Int
  quantity  Int

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([enquiryId, productId])
}

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNumber String          @unique
  enquiryId       Int             @unique
  customerId      Int
  validUntil      DateTime
  status          QuotationStatus @default(DRAFT)
  totalAmount     Decimal         @db.Decimal(14, 2)
  createdById     Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  enquiry   Enquiry          @relation(fields: [enquiryId], references: [id])
  customer  Customer         @relation(fields: [customerId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  items     QuotationItem[]
  salesOrder SalesOrder?
}

model QuotationItem {
  id             Int     @id @default(autoincrement())
  quotationId    Int
  productId      Int
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  discountPercent Decimal @db.Decimal(5, 2) @default(0)
  gstPercent      Decimal @db.Decimal(5, 2) @default(18)
  lineAmount      Decimal @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])
}

model SalesOrder {
  id            Int             @id @default(autoincrement())
  orderNumber   String          @unique
  quotationId   Int             @unique
  customerId    Int
  orderDate     DateTime        @default(now())
  totalAmount   Decimal         @db.Decimal(14, 2)
  status        SalesOrderStatus @default(PENDING)
  createdById   Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  quotation Quotation       @relation(fields: [quotationId], references: [id])
  customer  Customer        @relation(fields: [customerId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
  items     SalesOrderItem[]
  dispatch  Dispatch?
}

model SalesOrderItem {
  id           Int     @id @default(autoincrement())
  salesOrderId Int
  productId   Int
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([salesOrderId, productId])
}

model Dispatch {
  id            Int      @id @default(autoincrement())
  dispatchNumber String   @unique
  salesOrderId  Int      @unique
  dispatchDate  DateTime @default(now())
  vehicleNumber String
  driverName    String
  createdAt     DateTime @default(now())

  salesOrder SalesOrder    @relation(fields: [salesOrderId], references: [id])
  items      DispatchItem[]
}

model DispatchItem {
  id         Int @id @default(autoincrement())
  dispatchId Int
  productId  Int
  quantity   Int

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([dispatchId, productId])
}